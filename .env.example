# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored - NEVER commit real credentials.

# ---------------------------------------------------------------- Market data
# twelvedata (default): free key by email at https://twelvedata.com - no broker account needed.
#                       Mid prices only (no bid/ask/volume); EUR/USD 15m history from 2020-01-30.
# oanda:                needs an OANDA practice account; adds bid/ask/volume.
DATA_PROVIDER=twelvedata

# Twelve Data API key (dashboard -> API Keys)
TWELVEDATA_API_KEY=
# Free Basic plan allows 8 requests/minute and 800/day (about 47 requests per instrument for full history).
TWELVEDATA_REQUESTS_PER_MINUTE=8

# OANDA (optional, only used when DATA_PROVIDER=oanda)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# ---------------------------------------------------------------- Database
# Default: local SQLite file backend/data/forex_ai.db (nothing to install). Leave empty to use it.
# To use PostgreSQL instead:  DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/forex_ai
DATABASE_URL=

# ---------------------------------------------------------------- Instruments
# Watchlist: any forex pairs and spot metals, comma-separated. The first one is shown by default.
# Examples: EUR_USD GBP_USD USD_JPY AUD_USD NZD_USD USD_CAD USD_CHF EUR_GBP GBP_JPY AUD_JPY
#           XAU_USD (gold) XAG_USD (silver) XPT_USD (platinum)       -- crypto and stocks are not supported
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,XAU_USD
GRANULARITY=M15
# How many years of history the first download requests (capped by what the provider has)
HISTORY_YEARS=10

# ---------------------------------------------------------------- Risk (all configurable)
# V1 supports paper trading only. Any other value is rejected.
TRADING_MODE=paper
ACCOUNT_BALANCE=100
# Beginner-safe defaults (all are % of the CURRENT balance, so they grow with the account):
# Maximum LOSS if the stop loss is hit: 1 = $1 on $100. This decides the position size. Allowed: >0 and <=5
MAX_RISK_PERCENT=1
# Maximum MARGIN one trade may lock up: 25 = $25 on $100. With 3 open trades that is at most $75 of margin.
MAX_TRADE_ALLOCATION_PERCENT=25
# Up to 3 open trades at once (one per pair)
MAX_OPEN_TRADES=3
# After losing this much in one day (3 = $3), no new trades until the next day
MAX_DAILY_LOSS_PERCENT=3
# Broker leverage = position value / margin. 30 is the regulated retail standard (20 for gold).
LEVERAGE_FOREX=30
LEVERAGE_METAL=20
STOP_LOSS_ATR_MULTIPLIER=1
TAKE_PROFIT_ATR_MULTIPLIER=1.5

# ---------------------------------------------------------------- Signals
# Minimum model probability for BUY/SELL; otherwise WAIT. To be tuned on validation data.
SIGNAL_PROBABILITY_THRESHOLD=0.65
# Maximum time a trade is held before the coach says "close": 4 x 15 min = 1 hour.
# Labels for training use the same limit (with 1 hour the 2R target is almost never reached).
MAX_HOLDING_CANDLES=4
PREDICTION_HORIZON_CANDLES=4
# Modelled spread in pips (Twelve Data has no bid/ask). Empty = built-in cautious table
# (EUR_USD 1.0, GBP_USD 1.4, USD_JPY 1.2, AUD_USD 1.2, XAU_USD 30 = $0.30). Example: EUR_USD:0.8,XAU_USD:25
SPREAD_PIPS_OVERRIDES=

# ---------------------------------------------------------------- Live coach
# practice = show the model's BUY/SELL even though it has NOT proven an edge (labelled "unproven", demo only)
# proven   = only signals from a model that passed every test (today that means WAIT only)
COACH_MODE=practice
# Practice only: a BUY/SELL needs at least this probability (0.40 = 40%). Lower = more but weaker signals.
# Out-of-sample 2022-2026 (stop 1 ATR, target 1.5 ATR, 1 hour): 0.35 lost -0.09 R per trade, 0.45 about break-even,
# 0.50 +0.08 to +0.12 R but only ~1-2 signals a WEEK (all pairs). Empty = training's choice.
PRACTICE_SIGNAL_THRESHOLD=0.50
# The live engine runs inside the API server: fetches each new 15-minute candle (1 request per pair per candle,
# ~96/day per pair) and streams real-time ticks for EUR/USD and gold (free Twelve Data WebSocket).
LIVE_ENGINE_ENABLED=true
LIVE_PRICE_STREAM=true
# How long a BUY/SELL can still be taken after the candle closes (minutes)
SIGNAL_EXPIRY_MINUTES=5
# Pairs without the free live stream (all except EUR/USD and gold): check the price this often while you
# have a trade open on them. 1 API credit per check (~20 per 30-minute trade). 0 = only every 15 minutes.
LIVE_TRADE_PRICE_SECONDS=90
# Safety cap on API credits per day (free plan: 800); open-trade price checks pause first.
DAILY_REQUEST_BUDGET=760

# ---------------------------------------------------------------- App
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Phone notifications (Telegram): a short "BUY EUR/USD / TP / SL" message for every signal.
# 1) In Telegram open @BotFather, send /newbot, copy the token here.  2) Send your bot any message.
# 3) From backend/: python -m app.notify.telegram  (fills TELEGRAM_CHAT_ID and sends a test). Blank = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
